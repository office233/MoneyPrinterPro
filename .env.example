# =============================================================================
# Money Printer Pro - Optional Environment Configuration
# =============================================================================
# This file is OPTIONAL. The product is BYOK (Bring Your Own Key):
# every user enters their own Gemini API key in the UI (Settings page),
# and the browser sends it to the server via the x-api-key header.
#
# The server intentionally has NO API key. Do not add one here.
# =============================================================================

# Optional model override. Defaults to gemini-2.5-flash-image.
# Only set this if you want all users to use a different image model.
# IMAGE_MODEL=gemini-2.5-flash-image

